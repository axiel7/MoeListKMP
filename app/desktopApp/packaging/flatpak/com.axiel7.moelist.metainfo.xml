<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>com.axiel7.moelist</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0</project_license>
    <name>MoeList</name>
    <summary>Another unofficial Android MAL client</summary>
    <description>
        <p>MoeList is an unofficial MAL (MyAnimeList) client, with this app you can easily track, rate, organize and discover new Anime &amp; Manga.</p>
    </description>

    <launchable type="desktop-id">moelist.desktop</launchable>

    <screenshots>
        <screenshot type="default">
            <caption>Discover new Anime and Manga!</caption>
            <image>https://github.com/axiel7/MoeListKMP/blob/main/app/desktopApp/packaging/flatpak/1_home.png?raw=true</image>
        </screenshot>
        <screenshot>
            <caption>Track your progress with your personal list.</caption>
            <image>https://github.com/axiel7/MoeListKMP/blob/main/app/desktopApp/packaging/flatpak/2_list.png?raw=true</image>
        </screenshot>
        <screenshot>
            <caption>Search information about your favorites series.</caption>
            <image>https://github.com/axiel7/MoeListKMP/blob/main/app/desktopApp/packaging/flatpak/3_details.png?raw=true</image>
        </screenshot>
        <screenshot>
            <caption>View your profile with detailed statistics!</caption>
            <image>https://github.com/axiel7/MoeListKMP/blob/main/app/desktopApp/packaging/flatpak/4_profile.png?raw=true</image>
        </screenshot>
    </screenshots>

